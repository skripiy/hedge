# ==============================
# Database Configuration
# ==============================
POSTGRES_USER=hedge_user
POSTGRES_PASSWORD=hedge_pass
POSTGRES_DB=hedge_db
DATABASE_URL=postgresql+asyncpg://hedge_user:hedge_pass@db:5432/hedge_db

# ==============================
# Trading Mode
# ==============================
# Options: simulation, live
TRADING_MODE=simulation

# ==============================
# Exchange Configuration
# ==============================
EXCHANGE_A=binance
EXCHANGE_B=bybit
SYMBOL=BTC/USDT

# API Keys for Exchange A (required for live trading)
EXCHANGE_A_API_KEY=
EXCHANGE_A_SECRET=

# API Keys for Exchange B (required for live trading)
EXCHANGE_B_API_KEY=
EXCHANGE_B_SECRET=

# ==============================
# Trading Parameters
# ==============================
# Position size in USDT
POSITION_SIZE_USDT=100

# Leverage (1-100)
LEVERAGE=1

# Minimum spread % to trigger entry
SPREAD_THRESHOLD=0.5

# Stop-loss % per position
STOP_LOSS_PERCENT=2.0

# Take-profit % per position
TAKE_PROFIT_PERCENT=5.0

# Interval between checks in seconds
CHECK_INTERVAL=5

# Auto-trade when opportunity detected (true/false)
AUTO_TRADE=false

# ==============================
# Logging
# ==============================
DEBUG=false
